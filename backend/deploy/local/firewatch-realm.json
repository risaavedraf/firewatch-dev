{
  "realm": "firewatch",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {"realm": [{"name": "viewer"}, {"name": "admin"}]},
  "clients": [{
    "clientId": "firewatch-demo",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:8080/", "http://localhost:4173/"],
    "webOrigins": ["http://localhost:8080", "http://localhost:4173"],
    "protocol": "openid-connect",
    "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:8080/##http://localhost:4173/"},
    "protocolMappers": [{
      "name": "api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {"included.custom.audience": "firewatch-api", "access.token.claim": "true", "id.token.claim": "false"}
    }, {
      "name": "realm-roles",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-realm-role-mapper",
      "config": {"claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false"}
    }]
  }],
  "users": [{
    "username": "demo-admin", "enabled": true,
    "firstName": "Demo", "lastName": "Admin", "email": "admin@example.invalid", "emailVerified": true,
    "realmRoles": ["admin", "viewer"],
    "credentials": [{"type": "password", "value": "${DEMO_ADMIN_PASSWORD}", "temporary": false}]
  }, {
    "username": "demo-viewer", "enabled": true,
    "firstName": "Demo", "lastName": "Viewer", "email": "viewer@example.invalid", "emailVerified": true,
    "realmRoles": ["viewer"],
    "credentials": [{"type": "password", "value": "${DEMO_VIEWER_PASSWORD}", "temporary": false}]
  }]
}
