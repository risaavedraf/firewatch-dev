# Documented local-development values. This file is NOT configuration: Vite does
# not read it. Vite loads `.env`, `.env.local`, `.env.[mode]` and
# `.env.[mode].local`, which stay untracked; create one of those if you need to
# override something. This file is the reference they must agree with.
#
# These are exactly the strings src/config.ts uses as its development fallback,
# so a checkout with no env file behaves identically to this one.
# Nothing inlined into a public bundle may be a credential: Vite embeds every
# VITE_* value verbatim into the shipped JavaScript.

# Absolute origin of the gateway (scheme + host + port, no trailing slash).
VITE_GATEWAY_ORIGIN=http://localhost:8080

# The identity provider, not the gateway: it must point at the realm issuer.
VITE_ISSUER=http://localhost:8081/realms/firewatch

# Must be byte-identical to the Keycloak client's registered redirect URI and to
# the gateway's WEB_ORIGIN. The trailing slash is part of the value.
VITE_REDIRECT_URI=http://localhost:4173/
