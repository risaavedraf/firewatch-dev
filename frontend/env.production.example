# Documented production-build values. Like env.example, this file is a reference:
# Vite does not read it. The three values must be present in the build
# environment or in an untracked `.env.production`, because `npm run build`
# fails with "FAIL: missing required build variable(s)" when any is absent.
#
# Those placeholders are not real hosts. Replace them before deploying.

# Must equal the public domain of the page, over https.
VITE_GATEWAY_ORIGIN=https://firewatch.example.com

# Must equal KC_HOSTNAME plus the realm path of the identity provider.
VITE_ISSUER=https://auth.firewatch.example.com/realms/firewatch

# Must equal the client's registered redirect URI and the gateway's WEB_ORIGIN.
# A browser treats localhost and 127.0.0.1 as different origins; do not mix them.
VITE_REDIRECT_URI=https://firewatch.example.com/
